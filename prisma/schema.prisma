// Prisma schema — komikstream
// Sprint 0 task 4: User.tier, User.preferences, User.lastSeenAt, Subscription, PushSubscription
// Plus core models per SRS §5.1: Komik, KomikChapter, Bookmark, History

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"

}

enum Tier {
  free
  premium
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  grace
}

enum PaymentProvider {
  ipaymu
}

model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  email       String   @unique
  tier        Tier     @default(free)
  preferences Json?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions     Subscription[]
  pushSubscriptions PushSubscription[]
  bookmarks         Bookmark[]
  histories         History[]
}

model Subscription {
  id         String             @id @default(cuid())
  userId     String
  status     SubscriptionStatus @default(active)
  provider   PaymentProvider
  externalId String?            @unique
  startsAt   DateTime           @default(now())
  endsAt     DateTime?
  graceUntil DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Komik {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  genres    Json?
  chapters  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  komikChapters KomikChapter[]
}

model KomikChapter {
  id        String   @id @default(cuid())
  komikId   String
  chapterId String   @unique
  images    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  komik Komik @relation(fields: [komikId], references: [id], onDelete: Cascade)

  @@index([komikId])
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String   @default("komik")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, contentType])
}

model History {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String   @default("komik")
  lastPage    Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, contentType])
  @@index([userId, updatedAt])
}
